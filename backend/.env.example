# Example backend environment settings for GYAAN

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama2

# OpenRouter provider:
#LLM_PROVIDER=openrouter
#OPENROUTER_API_KEY=sk-or-your-key-here
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#LLM_MODEL=openai/gpt-4o-mini

# OpenAI provider:
#LLM_PROVIDER=openai
#OPENAI_API_KEY=sk-your-key-here
#LLM_MODEL=gpt-4o-mini

# Set this only when using OpenAI-compatible hosted providers:
#LLM_MAX_TOKENS=4096

# Optional persistence configuration:
#DATABASE_URL=sqlite+aiosqlite:///./gyaan.db
#ENABLE_STARTUP_SCRAPE=true
